{
  "name": "koubo-frontend",
  "version": "1.0.0",
  "description": "口播小程序前端",
  "private": true,
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "dev:tt": "taro build --type tt --watch",
